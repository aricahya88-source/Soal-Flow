+
+function estimateRichBlockPoints(html: string | null | undefined, assetLinks: ExportAssetLink[] = [], size = 10) {
+  const text = htmlToText(html);
+  const textPoints = text ? estimatePdfTextPoints(text, size) : 0;
+  const imageCount = mergeImageRefs(extractImageRefsFromHtml(html), assetImageRefs(assetLinks)).length;
+  return textPoints + imageCount * 145;
+}
+
+function estimateQuestionPdfPoints(params: ExportParams, question: ExportQuestion) {
+  const version = question.currentVersion;
+  const options = (version?.options ?? []).slice().sort((left, right) => left.sortOrder - right.sortOrder);
+  let points = 78;
+  points += estimateRichBlockPoints(version?.stemHtml, version?.assets ?? [], 10);
+  for (const option of options) {
+    points += estimatePdfTextPoints(htmlToText(option.contentHtml), 10, 0, 26);
+    points += mergeImageRefs(extractImageRefsFromHtml(option.contentHtml), assetImageRefs(option.assets)).length * 145;
+  }
+  if (params.includeAnswer) points += 18;
+  if (params.includeExplanation && version?.explanationHtml) points += estimateRichBlockPoints(version.explanationHtml, [], 10) + 18;
+  return points;
+}
+
+function estimateStimulusPdfPoints(question: ExportQuestion) {
+  const stimulusVersion = question.stimulus?.currentVersion;
+  if (!stimulusVersion) return 0;
+  return 30
+    + estimateRichBlockPoints(stimulusVersion.instructionsHtml, [], 10)
+    + estimateRichBlockPoints(stimulusVersion.contentHtml, stimulusVersion.assets, 10)
+    + (stimulusVersion.source ? 16 : 0);
+}
