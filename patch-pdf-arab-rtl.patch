+async function buildRtlPdf(params: ExportParams, questions: ExportQuestion[]) {
+  // pdfmake-rtl embeds Cairo for Arabic/Persian/Urdu and performs RTL/bidi processing.
+  // require() is intentional here because the package is CommonJS and runs only in the Node.js route runtime.
+  // eslint-disable-next-line @typescript-eslint/no-require-imports
+  const PdfPrinter = require("pdfmake-rtl");
+  // eslint-disable-next-line @typescript-eslint/no-require-imports
+  const RobotoFonts = require("pdfmake-rtl/fonts/Roboto");
+  // eslint-disable-next-line @typescript-eslint/no-require-imports
+  const CairoFonts = require("pdfmake-rtl/fonts/Cairo");
+  const printer = new PdfPrinter({ ...RobotoFonts, ...CairoFonts });
+
+  const content: PdfMakeNode[] = [
+    pdfMakeText("SOALFLOW - EXPORT SOAL", { fontSize: 16, bold: true, margin: [0, 0, 0, 3] }),
+    pdfMakeText("Dokumen bank soal yang dibuat otomatis oleh SoalFlow.", { fontSize: 9.5, margin: [0, 0, 0, 7] }),
+    { canvas: [{ type: "line", x1: 0, y1: 0, x2: 511, y2: 0, lineWidth: 0.7 }], margin: [0, 0, 0, 7] },
+    pdfMakeText(`Tanggal export: ${dateTime(new Date())}`, { fontSize: 9 }),
+    pdfMakeText(`Status validasi: ${validationLabels[params.validation]}`, { fontSize: 9 }),
+    pdfMakeText(`Mode export: ${selectionLabels[params.selection]}`, { fontSize: 9 }),
+  ];
+
+  const selectedBlueprintCodes = effectiveBlueprintCodesForSummary(params);
+  const allAuthors = Array.from(new Set(questions.flatMap(questionAuthorNames)));
+  const allValidators = Array.from(new Set(questions.flatMap(questionValidatorNames)));
+  content.push(
+    pdfMakeText(`Kisi-kisi dipilih: ${selectedBlueprintCodes.length ? selectedBlueprintCodes.join(", ") : "Semua kisi-kisi"}`, { fontSize: 9 }),
+    pdfMakeText(`Jumlah soal: ${questions.length}`, { fontSize: 9 }),
+    pdfMakeText(`Jumlah kisi-kisi: ${new Set(questions.map((question) => question.blueprint.code)).size}`, { fontSize: 9 }),
+    pdfMakeText(`Penulis soal: ${assigneeLabel(allAuthors)}`, { fontSize: 9 }),
+    pdfMakeText(`Validator soal: ${assigneeLabel(allValidators)}`, { fontSize: 9, margin: [0, 0, 0, 10] }),
+  );
+
+  if (!questions.length) {
+    content.push(pdfMakeText("Tidak ada soal yang sesuai dengan pengaturan export.", { fontSize: 11 }));
+  }
+
+  let previousBlueprintCode = "";
+  let previousStimulusKey = "";
+
+  for (const [index, question] of questions.entries()) {
+    const version = question.currentVersion;
+    const blueprintVersion = question.blueprint.currentVersion;
+    const stimulusVersion = question.stimulus?.currentVersion;
+    const options = (version?.options ?? []).slice().sort((left, right) => left.sortOrder - right.sortOrder);
+    const blueprintChanged = question.blueprint.code !== previousBlueprintCode;
+
+    if (blueprintChanged) {
+      content.push(
+        { canvas: [{ type: "line", x1: 0, y1: 0, x2: 511, y2: 0, lineWidth: 0.6 }], margin: [0, 5, 0, 6] },
+        pdfMakeText(`Kisi-kisi ${question.blueprint.code}`, { fontSize: 12, bold: true, margin: [0, 0, 0, 4] }),
+      );
+      previousBlueprintCode = question.blueprint.code;
+      previousStimulusKey = "";
+
+      if (params.includeBlueprint) {
+        content.push(...pdfMakeLabelValue("Judul", blueprintVersion?.titleHtml));
+        content.push(...pdfMakeLabelValue("Kelompok tes", blueprintVersion?.testGroupHtml));
+        content.push(...pdfMakeLabelValue("Topik", blueprintVersion?.testTopicHtml));
+        content.push(...pdfMakeLabelValue("Kompetensi", blueprintVersion?.competencyHtml));
+        content.push(...pdfMakeLabelValue("Indikator", blueprintVersion?.indicatorHtml));
+        if (blueprintVersion?.cognitiveLevel) content.push(pdfMakeText(`Level kognitif: ${blueprintVersion.cognitiveLevel}`, { fontSize: 9, margin: [0, 0, 0, 5] }));
+      }
+    }
+
+    const stimulusKey = stimulusVersion ? `${question.blueprint.code}:${question.stimulus?.code ?? stimulusVersion.titleHtml ?? "stimulus"}` : "";
+    const shouldRenderStimulus = Boolean(params.includeStimulus && stimulusVersion && stimulusKey !== previousStimulusKey);
+
+    if (shouldRenderStimulus && stimulusVersion) {
+      const stimulusTitle = htmlToText(stimulusVersion.titleHtml);
+      content.push({
+        stack: [
+          pdfMakeText(`STIMULUS ${question.stimulus?.code ?? "-"}${stimulusTitle ? ` - ${stimulusTitle}` : ""}`, {
+            fontSize: 10.5,
+            bold: true,
+            margin: [0, 0, 0, 4],
+          }),
+          ...await pdfMakeRichBlock("Instruksi", stimulusVersion.instructionsHtml),
+          ...await pdfMakeRichBlock("Teks/gambar stimulus", stimulusVersion.contentHtml, stimulusVersion.assets),
+          ...(stimulusVersion.source ? [pdfMakeText(`Sumber: ${stimulusVersion.source}`, { fontSize: 8, margin: [0, 2, 0, 0] })] : []),
+        ],
+        margin: [0, 4, 0, 8],
+      });
+      previousStimulusKey = stimulusKey;
+    }
+
+    const questionStack: PdfMakeNode[] = [
+      pdfMakeText(`${index + 1}. ${question.code}`, { fontSize: 11, bold: true, margin: [0, 1, 0, 2] }),
+      pdfMakeText(`Status: ${question.status}`, { fontSize: 8 }),
+      pdfMakeText(`Penulis soal: ${assigneeLabel(questionAuthorNames(question))}`, { fontSize: 8 }),
+      pdfMakeText(`Validator soal: ${assigneeLabel(questionValidatorNames(question))}`, { fontSize: 8 }),
+    ];
+    if (version?.orderInStimulus != null) questionStack.push(pdfMakeText(`Urutan dalam stimulus: ${version.orderInStimulus}`, { fontSize: 8 }));
+    questionStack.push(...await pdfMakeRichBlock("Soal", version?.stemHtml, version?.assets ?? [], { bold: true }));
+
+    for (const option of options) questionStack.push(...await pdfMakeOptionBlock(option));
+
+    if (params.includeAnswer) {
+      questionStack.push(pdfMakeText(`Kunci jawaban: ${version?.answerKey ?? "-"}`, { fontSize: 10, bold: true, margin: [0, 3, 0, 2] }));
+    }
+    if (params.includeExplanation && version?.explanationHtml) {
+      questionStack.push(pdfMakeText("PEMBAHASAN", { fontSize: 9.5, bold: true, margin: [0, 3, 0, 2] }));
+      questionStack.push(...await pdfMakeRichBlock("", version.explanationHtml));
+    }
+
+    content.push({ stack: questionStack, margin: [0, 0, 0, 9] });
+  }
+
+  const docDefinition: PdfMakeNode = {
+    pageSize: "A4",
+    pageMargins: [42, 46, 42, 42],
+    content,
+    defaultStyle: {
+      font: "Roboto",
+      fontSize: 10,
+      lineHeight: 1.2,
+    },
+    header: () => pdfMakeText("SoalFlow - Export Soal", { fontSize: 7.5, alignment: "right", margin: [42, 20, 42, 0] }),
+    footer: (currentPage: number, pageCount: number) => pdfMakeText(`Halaman ${currentPage} dari ${pageCount}`, { fontSize: 7.5, alignment: "center", margin: [42, 0, 42, 16] }),
+    info: {
+      title: "SoalFlow - Export Soal",
+      author: "SoalFlow",
+      subject: "Export bank soal",
+    },
+  };
+
+  const pdfDoc = printer.createPdfKitDocument(docDefinition);
+  return createPdfMakeBuffer(pdfDoc);
+}
+
+
+function exportPdfNeedsRtl(params: ExportParams, questions: ExportQuestion[]) {
+  return questions.some((question) => {
+    const version = question.currentVersion;
+    const blueprint = question.blueprint.currentVersion;
+    const stimulus = question.stimulus?.currentVersion;
+    const texts: Array<string | null | undefined> = [
+      version?.stemHtml,
+      ...(version?.options ?? []).map((option) => option.contentHtml),
+      params.includeExplanation ? version?.explanationHtml : null,
+      params.includeBlueprint ? blueprint?.titleHtml : null,
+      params.includeBlueprint ? blueprint?.testGroupHtml : null,
+      params.includeBlueprint ? blueprint?.testTopicHtml : null,
+      params.includeBlueprint ? blueprint?.competencyHtml : null,
+      params.includeBlueprint ? blueprint?.indicatorHtml : null,
+      params.includeStimulus ? stimulus?.titleHtml : null,
+      params.includeStimulus ? stimulus?.instructionsHtml : null,
+      params.includeStimulus ? stimulus?.contentHtml : null,
+    ];
+    return texts.some((text) => containsArabic(htmlToText(text)));
+  });
+}
+
+async function buildPdf(params: ExportParams, questions: ExportQuestion[]) {
+  // Preserve the existing renderer for Latin-only exports so this patch only changes
+  // PDF behavior when Arabic-script content is actually present.
+  if (!exportPdfNeedsRtl(params, questions)) return buildLegacyPdf(params, questions);
+  return buildRtlPdf(params, questions);
+}
