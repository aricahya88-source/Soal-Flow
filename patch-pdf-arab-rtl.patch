+
+type PdfMakeNode = Record<string, any>;
+
+const ARABIC_SCRIPT_RE = /[\u0600-\u06FF\u0750-\u077F\u08A0-\u08FF\uFB50-\uFDFF\uFE70-\uFEFF]/;
+
+function containsArabic(value: string | null | undefined) {
+  return ARABIC_SCRIPT_RE.test(value ?? "");
+}
+
+function pdfMakeText(
+  value: string | null | undefined,
+  options: PdfMakeNode = {},
+): PdfMakeNode {
+  const text = String(value ?? "");
+  const arabic = containsArabic(text);
+  return {
+    text,
+    font: arabic ? "Cairo" : "Roboto",
+    alignment: arabic ? "right" : options.alignment,
+    ...(arabic ? { rtl: true } : {}),
+    ...options,
+    ...(arabic && options.alignment == null ? { alignment: "right" } : {}),
+  };
+}
+
+function pdfMakeLabelValue(label: string, value: string | null | undefined, marginBottom = 2): PdfMakeNode[] {
+  const text = htmlToText(value);
+  if (!text) return [];
+  return [
+    pdfMakeText(label, { bold: true, fontSize: 9, margin: [0, 0, 0, 1] }),
+    pdfMakeText(text, { fontSize: 9.5, lineHeight: 1.22, margin: [0, 0, 0, marginBottom] }),
+  ];
+}
+
+async function pdfMakeImageNodes(refs: ImageRef[]): Promise<PdfMakeNode[]> {
+  const nodes: PdfMakeNode[] = [];
+  for (const ref of refs) {
+    const loaded = await readImageBytes(ref);
+    const mime = loaded?.mimeType || mimeFromSource(ref.src, ref.mimeType);
+    if (loaded && (mime.includes("jpeg") || mime.includes("jpg") || mime.includes("png"))) {
+      const normalizedMime = mime.includes("png") ? "image/png" : "image/jpeg";
+      nodes.push({
+        image: `data:${normalizedMime};base64,${loaded.data.toString("base64")}`,
+        fit: [440, 280],
+        alignment: "center",
+        margin: [0, 5, 0, 3],
+      });
+      const caption = ref.caption ?? ref.alt;
+      if (caption) nodes.push(pdfMakeText(caption, { fontSize: 8, italics: true, alignment: "center", margin: [0, 0, 0, 4] }));
+    } else {
+      nodes.push(pdfMakeText(`[Gambar tidak dapat dimuat: ${imageDisplayName(ref)}]`, { fontSize: 8, italics: true, margin: [0, 2, 0, 3] }));
+    }
+  }
+  return nodes;
+}
+
+async function pdfMakeRichBlock(
+  label: string,
+  html: string | null | undefined,
+  assetLinks: ExportAssetLink[] = [],
+  options: PdfMakeNode = {},
+): Promise<PdfMakeNode[]> {
+  const nodes: PdfMakeNode[] = [];
+  const text = htmlToText(html);
+  const refs = mergeImageRefs(extractImageRefsFromHtml(html), assetImageRefs(assetLinks));
+
+  if (label && (text || refs.length)) {
+    nodes.push(pdfMakeText(label, { bold: true, fontSize: 9.5, margin: [0, 1, 0, 2] }));
+  }
+  if (text) {
+    nodes.push(pdfMakeText(text, {
+      fontSize: 10.5,
+      lineHeight: 1.3,
+      margin: [0, 0, 0, 3],
+      ...options,
+    }));
+  }
+  if (refs.length) nodes.push(...await pdfMakeImageNodes(refs));
+  return nodes;
+}
+
+async function pdfMakeOptionBlock(option: { label: string; contentHtml: string; assets: ExportAssetLink[] }): Promise<PdfMakeNode[]> {
+  const text = htmlToText(option.contentHtml);
+  const refs = mergeImageRefs(extractImageRefsFromHtml(option.contentHtml), assetImageRefs(option.assets));
+  const nodes: PdfMakeNode[] = [];
+
+  if (text) {
+    const arabic = containsArabic(text);
+    nodes.push({
+      columns: arabic
+        ? [
+            pdfMakeText(text, { width: "*", fontSize: 10.2, lineHeight: 1.28, alignment: "right", rtl: true }),
+            pdfMakeText(`${option.label}.`, { width: 25, bold: true, fontSize: 10.2, alignment: "right" }),
+          ]
+        : [
+            pdfMakeText(`${option.label}.`, { width: 25, bold: true, fontSize: 10.2 }),
+            pdfMakeText(text, { width: "*", fontSize: 10.2, lineHeight: 1.28 }),
+          ],
+      columnGap: 4,
+      margin: [0, 1, 0, refs.length ? 1 : 4],
+    });
+  } else if (refs.length) {
+    nodes.push(pdfMakeText(`${option.label}.`, { bold: true, fontSize: 10.2, margin: [0, 1, 0, 1] }));
+  }
+
+  if (refs.length) nodes.push(...await pdfMakeImageNodes(refs));
+  return nodes;
+}
+
+function createPdfMakeBuffer(pdfDoc: any): Promise<Buffer> {
+  return new Promise((resolve, reject) => {
+    const chunks: Buffer[] = [];
+    pdfDoc.on("data", (chunk: Buffer | Uint8Array) => chunks.push(Buffer.from(chunk)));
+    pdfDoc.on("end", () => resolve(Buffer.concat(chunks)));
+    pdfDoc.on("error", reject);
+    pdfDoc.end();
+  });
+}
